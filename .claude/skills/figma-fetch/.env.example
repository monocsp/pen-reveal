# figma-fetch — 설정 견본
#
#   이 파일만 커밋된다. 실제 값은 `.env` 에 넣는다(gitignore 됨):
#
#       cp .env.example .env
#
#   확인: `git check-ignore -v .claude/skills/figma-fetch/.env` 가 규칙을 출력해야 한다.

# Figma Personal Access Token.
#   발급: Figma → 계정 설정 → Security → Personal access tokens
#   필요 스코프: `file_content:read` (파일 트리), `file_dev_resources:read` 는 불필요.
#   ⚠️ `figd_` 로 시작하는 문자열이다. 절대 커밋·붙여넣기 공유하지 않는다.
FIGMA_TOKEN=

# 기본으로 열 파일 링크(선택). CLI 인자로 주면 이 값을 덮어쓴다.
#   예: https://www.figma.com/design/AbCdEf123/pen-reveal-maps?node-id=12-345
FIGMA_FILE_URL=

# 내려받을 기본 위치(선택). 상대경로는 레포 루트 기준.
FIGMA_OUT_DIR=
